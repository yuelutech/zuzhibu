{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "秘书局讲话稿草稿",
  "description": "codex exec --output-schema 用的最终回复形状。正文字段按 shared/skills/cadre-speech/SKILL.md 的结构；对照字段供复核清单。所有字段必填，没有内容的填空字符串或空数组。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "genre": {
      "type": "string",
      "enum": ["speech"]
    },
    "title": {
      "type": "string",
      "description": "主标题：单标题“在××上的讲话”，或双标题的内容标题"
    },
    "subtitle": {
      "type": "string",
      "description": "副标题“——在××上的讲话”；单标题时为空字符串"
    },
    "date_line": {
      "type": "string",
      "description": "日期行，形如“（2026年10月16日）”"
    },
    "speaker_line": {
      "type": "string",
      "description": "讲话人行：姓名，或职务＋姓名"
    },
    "salutation": {
      "type": "string",
      "description": "开头称谓，独立成段，以全角冒号结尾"
    },
    "opening": {
      "type": "array",
      "description": "开场段，最后一段是过渡句（“下面，我讲几点意见。”）",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "description": "分点主体，3 至 5 个一级部分",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "heading": {
            "type": "string",
            "description": "一级标题，形如“一、……”，不超过 25 字，无句末标点"
          },
          "paragraphs": {
            "type": "array",
            "description": "该部分的段落，至少 2 段",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["heading", "paragraphs"]
      }
    },
    "closing": {
      "type": "array",
      "description": "结尾段：呼语加号召，不超过 120 字",
      "items": {
        "type": "string"
      }
    },
    "thanks": {
      "type": "string",
      "description": "致谢行“谢谢大家！”，不要时为空字符串"
    },
    "glossary_used": {
      "type": "array",
      "description": "成稿用到的译名表条目",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "english": {
            "type": "string"
          },
          "zh": {
            "type": "string",
            "description": "成稿首次提及写法"
          }
        },
        "required": ["english", "zh"]
      }
    },
    "glossary_misses": {
      "type": "array",
      "description": "译名表没有的专名及处理",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "english": {
            "type": "string"
          },
          "zh": {
            "type": "string",
            "description": "成稿写法"
          },
          "reason": {
            "type": "string",
            "description": "依据：通行中文名、保留英文、音译待核等"
          }
        },
        "required": ["english", "zh", "reason"]
      }
    },
    "numbers": {
      "type": "array",
      "description": "成稿里每个数字与原文的对应",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "zh": {
            "type": "string",
            "description": "成稿写法，如“约3亿美元”"
          },
          "source": {
            "type": "string",
            "description": "原文片段，如“about three hundred million dollars”"
          }
        },
        "required": ["zh", "source"]
      }
    },
    "quotes": {
      "type": "array",
      "description": "成稿保留的引语与原文的对应",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "zh": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "required": ["zh", "source"]
      }
    },
    "dropped": {
      "type": "array",
      "description": "删去的原文内容概述：寒暄、玩笑、问答、重复",
      "items": {
        "type": "string"
      }
    },
    "review_notes": {
      "type": "string",
      "description": "给人工复核的说明：原文含糊处、待定项、取舍理由"
    }
  },
  "required": [
    "genre",
    "title",
    "subtitle",
    "date_line",
    "speaker_line",
    "salutation",
    "opening",
    "sections",
    "closing",
    "thanks",
    "glossary_used",
    "glossary_misses",
    "numbers",
    "quotes",
    "dropped",
    "review_notes"
  ]
}
