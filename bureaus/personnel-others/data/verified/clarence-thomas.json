      "sources": [
        {
          "id": "s1",
          "url": "https://www.supremecourt.gov/about/biographies.aspx",
          "title": "Current Members — Clarence Thomas",
          "published_at": null,
          "checked_at": "2026-10-18",
          "excerpt": "Clarence Thomas, Associate Justice, was born in the Pinpoint community near Savannah, Georgia on June 23, 1948. He attended Conception Seminary from 1967-1968 and received an A.B., cum laude, from College of the Holy Cross in 1971 and a J.D. from Yale Law School in 1974. He took his seat October 23, 1991.",
          "tier": 1
        },
        {
          "id": "s2",
          "url": "https://www.fjc.gov/history/judges/thomas-clarence",
          "title": "Thomas, Clarence | Federal Judicial Center",
          "published_at": null,
          "checked_at": "2026-10-18",
          "excerpt": "Assistant attorney general, Jefferson City, Missouri, 1974-1977; Attorney, Monsanto Company, St. Louis, Missouri, 1977-1979; Legislative assistant, U.S. Sen. John C. Danforth of Missouri, 1979-1981; Assistant secretary for civil rights, U.S. Department of Education, 1981-1982; Chairman, Equal Employment Opportunity Commission, 1982-1990. Confirmed by the Senate on March 6, 1990, and commission issued on March 6, 1990. Service terminated on October 23, 1991.",
          "tier": 1
        },
        {
          "id": "nat",
