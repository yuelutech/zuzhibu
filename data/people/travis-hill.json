    "sources": [
      {
        "id": "s1",
        "url": "https://www.fdic.gov/about/travis-hill",
        "title": "Travis Hill | FDIC.gov",
        "published_at": null,
        "checked_at": "2026-10-21",
        "excerpt": "Travis Hill is the 23rd Chairman of the Federal Deposit Insurance Corporation (FDIC) Board of Directors, currently serving a five-year term that began on January 2, 2026.",
        "tier": 1
      },
      {
        "id": "s2",
        "url": "https://www.fdic.gov/about/travis-hill",
        "title": "Travis Hill | FDIC.gov",
        "published_at": null,
        "checked_at": "2026-10-21",
        "excerpt": "Mr. Hill had previously served as FDIC’s Acting Chairman starting on January 20, 2025, and served as Vice Chairman beginning on January 5, 2023.",
        "tier": 1
      },
      {
        "id": "s3",
        "url": "https://www.fdic.gov/about/travis-hill",
        "title": "Travis Hill | FDIC.gov",
        "published_at": null,
        "checked_at": "2026-10-21",
        "excerpt": "Prior to his terms on the Board of Directors, he was Deputy to the Chairman for Policy from 2018 to 2022 and, before that, served as Senior Advisor to the Chairman.",
        "tier": 1
      },
      {
        "id": "s4",
        "url": "https://www.fdic.gov/about/travis-hill",
        "title": "Travis Hill | FDIC.gov",
        "published_at": null,
        "checked_at": "2026-10-21",
        "excerpt": "Prior to joining the FDIC, Mr. Hill served as Senior Counsel at the United States Senate Committee on Banking, Housing, and Urban Affairs, where he worked from 2013 to 2018.",
        "tier": 1
      },
      {
        "id": "s5",
        "url": "https://www.fdic.gov/about/travis-hill",
        "title": "Travis Hill | FDIC.gov",
        "published_at": null,
        "checked_at": "2026-10-21",
        "excerpt": "Before working at the Senate, Mr. Hill worked as a policy analyst at Regions Financial Corporation from 2011 to 2013.",
        "tier": 1
      },
      {
        "id": "s6",
        "url": "https://www.fdic.gov/about/travis-hill",
        "title": "Travis Hill | FDIC.gov",
        "published_at": null,
        "checked_at": "2026-10-21",
        "excerpt": "Mr. Hill received a Bachelor of Science from Duke University, where he studied economics and political science, and a Juris Doctor from Georgetown University Law Center.",
        "tier": 1
      },
      {
        "id": "s7",
        "url": "https://www.fdic.gov/news/press-releases/2026/travis-hill-sworn-23rd-chairman-fdic",
        "title": "Travis Hill Sworn in as the 23rd Chairman of the FDIC | FDIC.gov",
        "published_at": "2026-01-13",
        "checked_at": "2026-10-21",
        "excerpt": "Chairman Hill was nominated by President Trump on September 30, 2025, for a term of five years and confirmed by the Senate on December 18, 2025.",
        "tier": 1
      },
      {
        "id": "s8",
        "url": "https://www.fdic.gov/retirees/fdic-news-winter-2026.pdf",
        "title": "FDIC News, Winter 2026",
        "published_at": "2026",
        "checked_at": "2026-10-21",
        "excerpt": "On Tuesday, January 13, 2026, Travis Hill was sworn in as the 23rd Chairman of the Federal Deposit Insurance Corporation (FDIC).",
        "tier": 1
      },
      {
        "id": "s9",
        "url": "https://www.congress.gov/nomination/119th-congress/560/3",
        "title": "PN560-3 — Travis Hill — Federal Deposit Insurance Corporation, 119th Congress (2025-2026)",
        "published_at": "2025-09-30",
        "checked_at": "2026-10-21",
        "excerpt": "Travis Hill, of Maryland, to be Chairperson of the Board of Directors of the Federal Deposit Insurance Corporation for a term of five years, vice Martin J. Gruenberg, resigned.",
        "tier": 1
      },
      {
