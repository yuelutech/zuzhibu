      {
        "id": "s4",
        "url": "https://corporate.walmart.com/about/leadership/john-furner",
        "title": "John Furner, President and CEO, Walmart Inc.",
        "published_at": null,
        "checked_at": "2026-10-21",
        "excerpt": "Over the past three decades, he has held important roles throughout the company, including assistant store manager, store manager, district manager, buyer, regional general manager, divisional merchandising manager, VP of global sourcing, general merchandise manager, head of marketing and merchandising for Walmart China based in Shenzhen, and chief merchant for Sam’s Club U.S.",
        "tier": 1
      },
      {
        "id": "s5",
        "url": "https://corporate.walmart.com/content/corporate/en_us/news/2025/11/14/walmart-announces-john-furner-as-president-and-chief-executive-o0.html",
        "title": "Walmart Announces John Furner as President and Chief Executive Officer",
        "published_at": "2025-11-14",
        "checked_at": "2026-10-21",
        "excerpt": "BENTONVILLE, Ark., Nov. 14, 2025 — Walmart Inc. (NYSE: WMT) today announced that its Board of Directors has elected John Furner, 51, to succeed Doug McMillon, 59, as President and Chief Executive Officer of Walmart Inc., effective February 1, 2026. Furner was also elected to the company’s Board of directors, effective immediately.",
        "tier": 1
      },
      {
        "id": "s6",
        "url": "https://www.sec.gov/Archives/edgar/data/104169/000119312526173673/wmt-20260423.htm",
        "title": "Walmart Inc. 2026 Proxy Statement (DEF 14A)",
        "published_at": "2026-04-23",
        "checked_at": "2026-10-21",
        "excerpt": "John R. Furner President and CEO and Director Age: 51 Joined the Board: 2025",
        "tier": 1
      },
      {
        "id": "s7",
        "url": "https://www.sec.gov/Archives/edgar/data/104169/000119312526173673/wmt-20260423.htm",
        "title": "Walmart Inc. 2026 Proxy Statement (DEF 14A)",
        "published_at": "2026-04-23",
        "checked_at": "2026-10-21",
        "excerpt": "Mr. Furner has served on the board of the National Retail Federation since July 2017, of which he served as chairman from 2022 to 2025. Mr. Furner holds a Bachelor of Science in Business Administration in Marketing Management from the University of Arkansas.",
        "tier": 1
      },
      {
        "id": "s8",
        "url": "https://www.sec.gov/Archives/edgar/data/104169/000119312526173673/wmt-20260423.htm",
        "title": "Walmart Inc. 2026 Proxy Statement (DEF 14A)",
        "published_at": "2026-04-23",
        "checked_at": "2026-10-21",
        "excerpt": "Mr. McMillon retired as President and CEO effective January 31, 2026, and Mr. Furner was appointed President and CEO effective February 1, 2026.",
        "tier": 1
      },
      {
        "id": "s9",
        "url": "https://www.sec.gov/Archives/edgar/data/104169/000010416926000055/wmt-20260131.htm",
        "title": "Walmart Inc. Annual Report on Form 10-K for fiscal 2026 (Information About Our Executive Officers)",
        "published_at": "2026-03-13",
        "checked_at": "2026-10-21",
        "excerpt": "President and Chief Executive Officer, effective February 2026. From November 2019 to February 2026, he served as Executive Vice President, President and Chief Executive Officer, Walmart U.S.",
        "tier": 1
      },
      {
        "id": "s10",
        "url": "https://www.sec.gov/Archives/edgar/data/104169/000010416917000021/wmtform10-kx1312017.htm",
        "title": "Wal-Mart Stores, Inc. Annual Report on Form 10-K for fiscal 2017 (Executive Officers)",
        "published_at": "2017-03-31",
        "checked_at": "2026-10-21",
        "excerpt": "Executive Vice President, President and Chief Executive Officer, Sam's Club, effective February 1, 2017. From October 2015 to January 2017, he served as Executive Vice President and Chief Merchandising Officer of Sam's Club.",
        "tier": 1
      },
      {
        "id": "s11",
        "url": "https://www.sec.gov/Archives/edgar/data/104169/000010416917000021/wmtform10-kx1312017.htm",
        "title": "Wal-Mart Stores, Inc. Annual Report on Form 10-K for fiscal 2017 (Executive Officers)",
        "published_at": "2017-03-31",
        "checked_at": "2026-10-21",
        "excerpt": "From January 2013 to October 2015, he served as Senior Vice President and Chief Merchandising Officer of Walmart China. From January 2012 to January 2013 he served as Senior Vice President, Home & Apparel and Global Sourcing.",
        "tier": 1
      },
      {
        "id": "s12",
        "url": "https://www.sec.gov/Archives/edgar/data/104169/000010416920000011/wmtform10-kx1312020.htm",
        "title": "Walmart Inc. Annual Report on Form 10-K for fiscal 2020 (Executive Officers)",
        "published_at": "2020-03-20",
        "checked_at": "2026-10-21",
        "excerpt": "Executive Vice President, President and Chief Executive Officer, Walmart U.S. effective November 2019. From February 2017 until November 2019, he served as President and Chief Executive Officer, Sam's Club.",
        "tier": 1
      },
      {
        "id": "s13",
        "url": "https://corporate.walmart.com/news/2019/10/10/walmart-names-john-furner-president-ceo-of-walmart-u-s",
        "title": "Walmart Names John Furner President & CEO of Walmart U.S.",
        "published_at": "2019-10-10",
        "checked_at": "2026-10-21",
        "excerpt": "Furner, 45, started with Walmart as an hourly associate in 1993, working part-time in the garden center of a supercenter. He worked his way up through a number of frontline leadership roles, later becoming a store manager, district manager and buyer.",
        "tier": 1
      },
      {
