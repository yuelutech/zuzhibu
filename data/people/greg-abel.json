  "resume": {
    "id": "cadre-greg-abel",
    "line": "cadre",
    "subject_id": "greg-abel",
    "title": "格雷格·阿贝尔简历",
    "sources": [
      {
        "id": "s1",
        "url": "https://www.sec.gov/Archives/edgar/data/1067983/000119312526004727/d32284d8ka.htm",
        "title": "Berkshire Hathaway Inc. Form 8-K/A (Item 5.02), January 6, 2026",
        "published_at": "2026-01-06",
        "checked_at": "2026-10-21",
        "excerpt": "As previously announced, on January 1, 2026, Mr. Greg Abel became Berkshire’s President and Chief Executive Officer.",
        "tier": 1
      },
      {
        "id": "s2",
        "url": "https://www.sec.gov/Archives/edgar/data/1067983/000119312526106253/d882687ddef14a.htm",
        "title": "Berkshire Hathaway Inc. 2026 Proxy Statement (DEF 14A)",
        "published_at": "2026-03-13",
        "checked_at": "2026-10-21",
        "excerpt": "GREGORY E. ABEL, age 63, has been a director of the Corporation since 2018 and became Berkshire’s Chief Executive Officer on January 1, 2026.",
        "tier": 1
      },
      {
        "id": "s3",
        "url": "https://www.sec.gov/Archives/edgar/data/1067983/000119312526106253/d882687ddef14a.htm",
        "title": "Berkshire Hathaway Inc. 2026 Proxy Statement (DEF 14A)",
        "published_at": "2026-03-13",
        "checked_at": "2026-10-21",
        "excerpt": "He was the Corporation’s Vice Chairman – Non-Insurance Operations between 2018 and 2025. Between 2008 and 2018, Mr. Abel served as the Chief Executive Officer of Berkshire Hathaway Energy Company (“BHE”), a wholly owned Berkshire subsidiary.",
        "tier": 1
      },
      {
        "id": "s4",
        "url": "https://www.sec.gov/Archives/edgar/data/1067983/000119312526106253/d882687ddef14a.htm",
        "title": "Berkshire Hathaway Inc. 2026 Proxy Statement (DEF 14A)",
        "published_at": "2026-03-13",
        "checked_at": "2026-10-21",
        "excerpt": "Mr. Abel served as BHE’s Chairman until July 2025. Mr. Abel served as a director of The Kraft Heinz Company until May 2024.",
        "tier": 1
      },
      {
        "id": "s5",
        "url": "https://www.sec.gov/Archives/edgar/data/1067983/000119312526106253/d882687ddef14a.htm",
        "title": "Berkshire Hathaway Inc. 2026 Proxy Statement (DEF 14A)",
        "published_at": "2026-03-13",
        "checked_at": "2026-10-21",
        "excerpt": "Mr. Abel is a current director and Chairman Emeritus of the Horatio Alger Association of Distinguished Americans, Inc.",
        "tier": 1
      },
      {
        "id": "s6",
        "url": "https://www.sec.gov/Archives/edgar/data/1067983/000119312526106253/d882687ddef14a.htm",
        "title": "Berkshire Hathaway Inc. 2026 Proxy Statement (DEF 14A)",
        "published_at": "2026-03-13",
        "checked_at": "2026-10-21",
        "excerpt": "As previously announced, Gregory E. Abel succeeded Warren Buffett as Berkshire’s Chief Executive Officer on January 1, 2026. Mr. Buffett continues to be the Chairman of the Board of Directors.",
        "tier": 1
      },
      {
        "id": "s7",
        "url": "https://www.sec.gov/Archives/edgar/data/1067983/000119312526083899/brka-20251231.htm",
        "title": "Berkshire Hathaway Inc. Form 10-K for fiscal year 2025",
        "published_at": "2026-03-02",
        "checked_at": "2026-10-21",
        "excerpt": "Effective January 1, 2026, Mr. Abel became Berkshire’s Chief Executive Officer. Mr. Buffett remains the Chairman of Berkshire’s Board of Directors.",
        "tier": 1
      },
      {
        "id": "s8",
        "url": "https://www.sec.gov/Archives/edgar/data/1067983/000119312526083899/brka-20251231.htm",
        "title": "Berkshire Hathaway Inc. Form 10-K for fiscal year 2025 (signature page)",
        "published_at": "2026-03-02",
        "checked_at": "2026-10-21",
        "excerpt": "Director—President and Chief Executive Officer",
        "tier": 1
      },
      {
        "id": "s9",
        "url": "https://www.sec.gov/Archives/edgar/data/1067983/000119312525115695/d28310d8k.htm",
        "title": "Berkshire Hathaway Inc. Form 8-K (Item 5.02), May 8, 2025",
        "published_at": "2025-05-08",
        "checked_at": "2026-10-21",
        "excerpt": "On May 4, 2025, Berkshire’s Board of Directors voted unanimously to appoint Mr. Abel to become Berkshire’s President and CEO effective on January 1, 2026. Mr. Abel, age 62, has been a director of the Corporation and the Corporation’s Vice Chairman – Non-Insurance Operations since 2018.",
        "tier": 1
      },
      {
        "id": "s10",
        "url": "https://www.sec.gov/Archives/edgar/data/1067983/000119312525115695/d28310d8k.htm",
        "title": "Berkshire Hathaway Inc. Form 8-K (Item 5.02), May 8, 2025",
        "published_at": "2025-05-08",
        "checked_at": "2026-10-21",
        "excerpt": "Mr. Abel has served as BHE’s Chairman since 2011.",
        "tier": 1
      },
      {
        "id": "s11",
        "url": "https://www.sec.gov/Archives/edgar/data/1067983/000119312525115695/d28310d8k.htm",
        "title": "Berkshire Hathaway Inc. Form 8-K (Item 5.02), May 8, 2025",
        "published_at": "2025-05-08",
        "checked_at": "2026-10-21",
        "excerpt": "He was a director of AEGIS Insurance Services Inc., a provider of property and liability insurance for the energy industry, from 2016 – 2023.",
        "tier": 1
      },
      {
        "id": "s12",
        "url": "https://www.berkshirehathaway.com/news/jan1018.pdf",
        "title": "Berkshire Hathaway Inc. News Release, January 10, 2018",
        "published_at": "2018-01-10",
        "checked_at": "2026-10-21",
        "excerpt": "Gregory E. Abel and Ajit Jain were then elected to serve as Directors to fill the resulting vacancies on the Board of Directors.",
        "tier": 1
      },
      {
        "id": "s13",
        "url": "https://www.cbc.ca/news/business/berkshire-hathaway-1.6011602",
        "title": "Edmonton-born Greg Abel picked as Warren Buffett's successor as Berkshire Hathaway CEO (CBC News)",
        "published_at": "2021-05-03",
        "checked_at": "2026-10-21",
        "excerpt": "Abel was born in Edmonton, Alta., on June 1, 1962, which makes him almost 59 years old. He was educated at the University of Alberta with a degree in commerce, and he's an accountant by training.",
        "tier": 2
      },
      {
        "id": "s14",
        "url": "https://www.cnbc.com/make-it/2025/05/07/warren-buffett-greg-abel-understands-businesses-extremely-well.html",
        "title": "Warren Buffett: Greg Abel 'understands businesses extremely well' (CNBC)",
        "published_at": "2025-05-07",
        "checked_at": "2026-10-21",
        "excerpt": "He graduated from the University of Alberta in 1984 with a bachelor of commerce degree in accounting, and worked as an accountant after college — first for PricewaterhouseCoopers, and then with geothermal electricity company CalEnergy, which later became MidAmerican Energy.",
        "tier": 2
      },
      {
        "id": "s15",
        "url": "https://www.cnbc.com/2026/06/27/berkshire-ceo-greg-abel-sworn-in-as-us-citizen-at-baseball-game.html",
        "title": "Berkshire CEO Greg Abel sworn in as U.S. citizen at baseball game (CNBC)",
        "published_at": "2026-06-27",
        "checked_at": "2026-10-21",
        "excerpt": "Abel, a longtime Iowa resident who was born in the Canadian city of Edmonton in 1962, was among the 22 people from 16 countries who participated in an annual naturalization ceremony hosted by the Iowa Cubs Thursday night in Des Moines, before the AAA minor league baseball team played the Buffalo Bisons.",
        "tier": 2
      },
      {
        "id": "s16",
        "url": "https://www.cnbc.com/2026/06/27/berkshire-ceo-greg-abel-sworn-in-as-us-citizen-at-baseball-game.html",
        "title": "Berkshire CEO Greg Abel sworn in as U.S. citizen at baseball game (CNBC)",
        "published_at": "2026-06-27",
        "checked_at": "2026-10-21",
        "excerpt": "Berkshire Hathaway CEO Greg Abel is now a citizen of the United States.",
        "tier": 2
      },
      {
        "id": "s17",
        "url": "https://www.sec.gov/Archives/edgar/data/1081316/000108131605000022/mehc10k-2004.htm",
        "title": "MidAmerican Energy Holdings Company Form 10-K for fiscal year 2004",
        "published_at": "2005-03-01",
        "checked_at": "2026-10-21",
        "excerpt": "Mr. Abel joined MEHC in 1992 and initially served as Vice President and Controller. Mr. Abel is a Chartered Accountant and from 1984 to 1992 was employed by Price Waterhouse. As a Manager in the San Francisco office of Price Waterhouse, he was responsible for clients in the energy industry.",
        "tier": 1
      },
      {
        "id": "s18",
        "url": "https://www.sec.gov/Archives/edgar/data/1081316/000108131608000006/mehc10k-123107.htm",
        "title": "MidAmerican Energy Holdings Company Form 10-K for fiscal year 2007",
        "published_at": "2008-02-29",
        "checked_at": "2026-10-21",
        "excerpt": "Mr. Abel has been the President and Chief Operating Officer since 1998 and a director since 2000. Mr. Abel joined MEHC in 1992. Mr. Abel is also a director of PacifiCorp.",
        "tier": 1
      },
      {
        "id": "s19",
        "url": "https://www.sec.gov/Archives/edgar/data/1081316/000108131618000014/bhe123117form10-k.htm",
        "title": "Berkshire Hathaway Energy Company Form 10-K for fiscal year 2017",
        "published_at": "2018-02-26",
        "checked_at": "2026-10-21",
        "excerpt": "On January 10, 2018, Mr. Gregory E. Abel resigned as PacifiCorp's Chairman of the Board of Directors and Chief Executive Officer and Mr. William J. Fehrman was elected as PacifiCorp's Chairman of the Board of Directors and Chief Executive Officer.",
        "tier": 1
      },
      {
        "id": "s20",
        "url": "https://www.sec.gov/Archives/edgar/data/1081316/000108131618000014/bhe123117form10-k.htm",
        "title": "Berkshire Hathaway Energy Company Form 10-K for fiscal year 2017",
        "published_at": "2018-02-26",
        "checked_at": "2026-10-21",
        "excerpt": "As of February 16, 2018, Berkshire Hathaway, Mr. Walter Scott, Jr., a member of BHE's Board of Directors (along with his family members and related or affiliated entities) and Mr. Gregory E. Abel, BHE's Executive Chairman, beneficially owned 90.2%, 8.8% and 1.0%, respectively, of BHE's voting common stock.",
        "tier": 1
      },
      {
        "id": "s21",
        "url": "https://www.sec.gov/Archives/edgar/data/1637459/000110465923036287/tm2230899d2_def14a.htm",
