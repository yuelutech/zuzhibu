        "published_at": "2015-07-30",
        "checked_at": "2026-10-21",
        "excerpt": "Education: University of North Carolina, math major with a concentration in computer science",
        "tier": 2
      },
      {
        "id": "s16",
        "url": "https://kenaninstitute.unc.edu/event/deans-speaker-series-chuck-robbins/",
        "title": "Dean's Speaker Series: Chuck Robbins (Kenan Institute of Private Enterprise, UNC Kenan-Flagler Business School)",
        "published_at": "2019-04-25",
