  "resume": {
    "id": "cadre-robert-michael",
    "line": "cadre",
    "subject_id": "robert-michael",
    "title": "罗伯特·迈克尔简历",
    "sources": [
      {
        "id": "m1",
        "url": "https://www.abbvie.com/who-we-are/our-leaders/robert-michael.html",
        "title": "Robert A. Michael, Chairman of the Board and Chief Executive Officer (AbbVie leadership)",
        "published_at": null,
        "checked_at": "2026-10-21",
        "excerpt": "Rob Michael is the Chairman of the Board and Chief Executive Officer of AbbVie, a global biopharmaceutical company that employs approximately 57,000 people worldwide and has provided innovative medicines and products to more than 74 million people in over 180 countries.",
        "tier": 1
      },
      {
        "id": "m2",
        "url": "https://www.abbvie.com/who-we-are/our-leaders/robert-michael.html",
        "title": "Robert A. Michael, Chairman of the Board and Chief Executive Officer (AbbVie leadership)",
        "published_at": null,
        "checked_at": "2026-10-21",
        "excerpt": "Mr. Michael earned a bachelor’s degree in accounting from Indiana University Kelley School of Business and a Master of Business Administration from University of California Los Angeles Anderson School of Management.",
        "tier": 1
      },
      {
        "id": "m3",
        "url": "https://www.abbvie.com/who-we-are/our-leaders/robert-michael.html",
        "title": "Robert A. Michael, Chairman of the Board and Chief Executive Officer (AbbVie leadership)",
        "published_at": null,
        "checked_at": "2026-10-21",
        "excerpt": "He began his career with Abbott as a member of the financial development program.",
        "tier": 1
      },
      {
        "id": "m4",
        "url": "https://www.sec.gov/Archives/edgar/data/1551152/000110465926033387/abbv-20260508xdef14a.htm",
        "title": "AbbVie Inc., 2026 Proxy Statement (Schedule 14A)",
        "published_at": "2026-03-23",
        "checked_at": "2026-10-21",
        "excerpt": "Mr. Michael is AbbVie’s Chairman and Chief Executive Officer, a position he has held since July 2025.",
        "tier": 1
      },
      {
        "id": "m5",
        "url": "https://www.sec.gov/Archives/edgar/data/1551152/000110465926033387/abbv-20260508xdef14a.htm",
        "title": "AbbVie Inc., 2026 Proxy Statement (Schedule 14A)",
        "published_at": "2026-03-23",
        "checked_at": "2026-10-21",
        "excerpt": "Mr. Michael previously served as Chief Executive Officer starting in 2024 and President and Chief Operating Officer from July 2023 to June 2024, where he was responsible for global commercial operations, finance, corporate human resources, global operations, business development and corporate strategy for the company.",
        "tier": 1
      },
      {
        "id": "m6",
        "url": "https://www.sec.gov/Archives/edgar/data/1551152/000110465926033387/abbv-20260508xdef14a.htm",
        "title": "AbbVie Inc., 2026 Proxy Statement (Schedule 14A)",
        "published_at": "2026-03-23",
        "checked_at": "2026-10-21",
        "excerpt": "He previously served as Vice Chairman and President from June 2022 to July 2023, as Vice Chairman, Finance and Commercial Operations and Chief Financial Officer from June 2021 to June 2022, as Executive Vice President, Chief Financial Officer from 2019 to 2021, and as Senior Vice President, Chief Financial Officer from 2018 to 2019.",
        "tier": 1
      },
      {
        "id": "m7",
        "url": "https://www.sec.gov/Archives/edgar/data/1551152/000110465926033387/abbv-20260508xdef14a.htm",
        "title": "AbbVie Inc., 2026 Proxy Statement (Schedule 14A)",
        "published_at": "2026-03-23",
        "checked_at": "2026-10-21",
        "excerpt": "Mr. Michael first joined Abbott in 1993 and held numerous leadership positions across several different business units before joining AbbVie in 2013.",
        "tier": 1
      },
      {
        "id": "m8",
        "url": "https://www.sec.gov/Archives/edgar/data/1551152/000110465926033387/abbv-20260508xdef14a.htm",
        "title": "AbbVie Inc., 2026 Proxy Statement (Schedule 14A)",
        "published_at": "2026-03-23",
        "checked_at": "2026-10-21",
        "excerpt": "Age: 55 Primary Occupation: Chairman of the Board and Chief",
        "tier": 1
      },
      {
        "id": "m9",
        "url": "https://www.sec.gov/Archives/edgar/data/1551152/000110465926033387/abbv-20260508xdef14a.htm",
        "title": "AbbVie Inc., 2026 Proxy Statement (Schedule 14A)",
        "published_at": "2026-03-23",
        "checked_at": "2026-10-21",
        "excerpt": "(2) Mr. Michael turning age 55 in 2025, which resulted in a one-time increase in the present value of his subsidized early retirement benefits payable for service after 2003",
        "tier": 1
      },
      {
        "id": "m10",
        "url": "https://www.sec.gov/Archives/edgar/data/1551152/000110465926033387/abbv-20260508xdef14a.htm",
        "title": "AbbVie Inc., 2026 Proxy Statement (Schedule 14A)",
        "published_at": "2026-03-23",
        "checked_at": "2026-10-21",
        "excerpt": "appointed Robert Michael as AbbVie’s CEO in July 2024 and as the Board’s Chairman in July 2025, succeeding Richard Gonzalez",
        "tier": 1
      },
      {
        "id": "m11",
        "url": "https://www.sec.gov/Archives/edgar/data/1551152/000110465926033387/abbv-20260508xdef14a.htm",
        "title": "AbbVie Inc., 2026 Proxy Statement (Schedule 14A)",
        "published_at": "2026-03-23",
        "checked_at": "2026-10-21",
        "excerpt": "As announced on February 14, 2025, Mr. Michael, AbbVie’s Chief Executive Officer, became Chairman of the Board effective July 1, 2025.",
        "tier": 1
      },
      {
        "id": "m12",
        "url": "https://news.abbvie.com/2024-02-20-AbbVie-Announces-Appointment-of-Robert-A-Michael-as-Chief-Executive-Officer",
        "title": "AbbVie Announces Appointment of Robert A. Michael as Chief Executive Officer",
        "published_at": "2024-02-20",
        "checked_at": "2026-10-21",
        "excerpt": "Additionally, the board has appointed Mr. Michael as a member of the board of directors effective July 1, 2024.",
        "tier": 1
      },
      {
        "id": "m13",
        "url": "https://news.abbvie.com/2024-02-20-AbbVie-Announces-Appointment-of-Robert-A-Michael-as-Chief-Executive-Officer",
        "title": "AbbVie Announces Appointment of Robert A. Michael as Chief Executive Officer",
        "published_at": "2024-02-20",
        "checked_at": "2026-10-21",
        "excerpt": "He began his career with Abbott as a member of the financial development program and ultimately served as division controller, nutrition supply chain and division controller, molecular diagnostics, among other roles.",
        "tier": 1
      },
      {
        "id": "m14",
        "url": "https://news.abbvie.com/2024-02-20-AbbVie-Announces-Appointment-of-Robert-A-Michael-as-Chief-Executive-Officer",
        "title": "AbbVie Announces Appointment of Robert A. Michael as Chief Executive Officer",
        "published_at": "2024-02-20",
        "checked_at": "2026-10-21",
        "excerpt": "Upon AbbVie's separation from Abbott in 2013, Mr. Michael established and led the company's first financial planning organization as vice president, AbbVie financial planning and analysis.",
        "tier": 1
      },
      {
        "id": "m15",
        "url": "https://news.abbvie.com/2024-02-20-AbbVie-Announces-Appointment-of-Robert-A-Michael-as-Chief-Executive-Officer",
        "title": "AbbVie Announces Appointment of Robert A. Michael as Chief Executive Officer",
        "published_at": "2024-02-20",
        "checked_at": "2026-10-21",
        "excerpt": "He then held a series of leadership roles of increasing responsibility including vice president, controller for commercial operations; vice president, treasurer; and vice president, corporate controller.",
        "tier": 1
      },
      {
        "id": "m16",
        "url": "https://news.abbvie.com/2024-02-20-AbbVie-Announces-Appointment-of-Robert-A-Michael-as-Chief-Executive-Officer",
        "title": "AbbVie Announces Appointment of Robert A. Michael as Chief Executive Officer",
        "published_at": "2024-02-20",
        "checked_at": "2026-10-21",
        "excerpt": "Mr. Gonzalez, who has served as CEO since the company's formation in 2013, will retire from the role of CEO and become executive chairman of the board of directors, effective July 1, 2024.",
        "tier": 1
      },
      {
        "id": "m17",
        "url": "https://news.abbvie.com/2025-02-14-AbbVie-Appoints-CEO-Robert-A-Michael-as-Chairman-of-the-Board-of-Directors",
        "title": "AbbVie Appoints CEO Robert A. Michael as Chairman of the Board of Directors",
        "published_at": "2025-02-14",
        "checked_at": "2026-10-21",
        "excerpt": "AbbVie (NYSE: ABBV) today announced that its board of directors has unanimously elected chief executive officer (CEO) Robert A. Michael to assume the additional position of chairman, effective July 1, 2025.",
        "tier": 1
      }
    ],
